local function UpdateInformation(container, player)
    local character = player.Character
    local root = GetRoot(character)

    if not character or not root or not IsVisualTargetValid(player) then
        if container.Billboard then
            container.Billboard.Enabled = false
        end

        return
    end

    local billboard = CreateBillboard(container)
    billboard.Enabled = Settings.ShowName
        or Settings.ShowUsername
        or Settings.ShowTeam
        or Settings.ShowDistance
        or Settings.ShowLookDirection

    if not billboard.Enabled then
        return
    end

    local background = billboard:FindFirstChild("Background")

    if not background then
        return
    end

    for _, child in ipairs(background:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    if Settings.ShowName then
        if Settings.ShowDisplayName then
            local label = AddInformationLabel(
                background,
                player.DisplayName
            )

            label.TextColor3 = Color3.new(1, 1, 1)
            label.Visible = true
        end
    end

    if Settings.ShowUsername then
        local label = AddInformationLabel(
            background,
            "@" .. player.Name
        )

        label.Visible = true
    end

    if Settings.ShowTeam then
        local teamName = player.Team and player.Team.Name or "No Team"

        local label = AddInformationLabel(
            background,
            teamName
        )

        if Settings.ShowTeamColor and player.Team then
            label.TextColor3 = player.TeamColor.Color
        end

        label.Visible = true
    end

    if Settings.ShowDistance then
        local distance = math.floor(GetDistance(player) + 0.5)

        local label = AddInformationLabel(
            background,
            tostring(distance) .. " studs"
        )

        label.Visible = true
    end

    if Settings.ShowLookDirection then
        local label = AddInformationLabel(
            background,
            GetCameraHorizontalDirection(root.Position)
        )

        label.Visible = true
    end
end

