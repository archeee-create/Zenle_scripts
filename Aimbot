local ConfigFolder = "ZenleScript"
local ConfigFile = ConfigFolder .. "/settings.json"

local function CanUseFileSystem()
    return type(isfolder) == "function"
        and type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
        and type(makefolder) == "function"
end

local function SaveSettings()
    if not CanUseFileSystem() then
        return
    end

    pcall(function()
        if not isfolder(ConfigFolder) then
            makefolder(ConfigFolder)
        end

        writefile(
            ConfigFile,
            HttpService:JSONEncode(Settings)
        )
    end)
end

local function LoadSettings()
    if not CanUseFileSystem() then
        return
    end

    pcall(function()
        if not isfile(ConfigFile) then
            return
        end

        local data = HttpService:JSONDecode(
            readfile(ConfigFile)
        )

        if type(data) ~= "table" then
            return
        end

        for key, value in pairs(data) do
            if Settings[key] ~= nil then
                Settings[key] = value
            end
        end

        if data.IgnoreTeam ~= nil then
            if data.AimIgnoreTeam == nil then
                Settings.AimIgnoreTeam = data.IgnoreTeam
            end

            if data.VisualsIgnoreTeam == nil then
                Settings.VisualsIgnoreTeam = data.IgnoreTeam
            end
        end
    end)
end

