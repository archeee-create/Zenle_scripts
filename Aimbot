local function UpdateAlert(player)
    local alert = AlertObjects[player]

    if not alert then
        alert = CreateAlert(player)
    end

    if not VisualsEnabled
        or not Settings.Show360Alert
        or not IsVisualTargetValid(player) then

        alert.Frame.Visible = false
        return
    end

    local character = player.Character
    local root = GetRoot(character)

    if not root or not Camera then
        alert.Frame.Visible = false
        return
    end

    if IsHorizontallyOnScreen(root.Position) then
        alert.Frame.Visible = false
        return
    end

    local cameraPosition = Camera.CFrame.Position
    local direction = root.Position - cameraPosition
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude <= 0.01 then
        alert.Frame.Visible = false
        return
    end

    direction = direction.Unit

    local right = Camera.CFrame.RightVector
    right = Vector3.new(right.X, 0, right.Z)

    local forward = Camera.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)

    if right.Magnitude <= 0.01 or forward.Magnitude <= 0.01 then
        alert.Frame.Visible = false
        return
    end

    right = right.Unit
    forward = forward.Unit

    local x = right:Dot(direction)
    local y = forward:Dot(direction)

    local angle = math.atan2(x, y)

    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local radius = math.min(viewport.X, viewport.Y) * 0.38

    local position = center + Vector2.new(
        math.sin(angle) * radius,
        -math.cos(angle) * radius
    )

    local halfWidth = 105
    local halfHeight = 41

    position = Vector2.new(
        math.clamp(
            position.X,
            halfWidth + 8,
            viewport.X - halfWidth - 8
        ),
        math.clamp(
            position.Y,
            halfHeight + 8,
            viewport.Y - halfHeight - 8
        )
    )

    alert.Frame.Position = UDim2.fromOffset(
        position.X,
        position.Y
    )

    alert.Image.Visible = Settings.AlertCharacter

    alert.Name.Visible = Settings.AlertName
    alert.Username.Visible = Settings.AlertUsername
    alert.Team.Visible = Settings.AlertTeam
    alert.Distance.Visible = Settings.AlertDistance
    alert.Direction.Visible = Settings.AlertLookDirection

    if Settings.AlertName then
        alert.Name.Text = player.DisplayName
    end

    if Settings.AlertUsername then
        alert.Username.Text = "@" .. player.Name
    end

    if Settings.AlertTeam then
        local teamName = player.Team and player.Team.Name or "No Team"
        alert.Team.Text = teamName

        if player.Team and Settings.ShowTeamColor then
            alert.Team.TextColor3 = player.TeamColor.Color
        else
            alert.Team.TextColor3 = Color3.new(1, 1, 1)
        end
    end

    if Settings.AlertDistance then
        alert.Distance.Text =
            tostring(math.floor(GetDistance(player) + 0.5)) .. " studs"
    end

    if Settings.AlertLookDirection then
        alert.Direction.Text =
            GetCameraHorizontalDirection(root.Position)
    end

    alert.Frame.Visible = true
end

