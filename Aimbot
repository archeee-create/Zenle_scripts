local function UpdateLookDirection(container, player)
    if not container or not container.LookLine or not container.LookTip then
        return
    end

    if not Settings.ShowLookDirection or not IsVisualTargetValid(player) then
        container.LookLine.Transparency = 1
        container.LookTip.Transparency = 1
        return
    end

    local character = player.Character
    local root = GetRoot(character)

    if not root then
        container.LookLine.Transparency = 1
        container.LookTip.Transparency = 1
        return
    end

    local startPosition = root.Position + Vector3.new(0, 1.5, 0)
    local endPosition = startPosition + root.CFrame.LookVector * 5

    local direction = endPosition - startPosition
    local length = direction.Magnitude

    if length <= 0.01 then
        return
    end

    container.LookLine.Size = Vector3.new(0.08, 0.08, length)
    container.LookLine.CFrame =
        CFrame.lookAt(startPosition + direction / 2, endPosition)

    container.LookLine.Transparency = 0.1

    container.LookTip.Size = Vector3.new(0.35, 0.35, 0.35)
    container.LookTip.CFrame = CFrame.new(endPosition)
    container.LookTip.Transparency = 0
end

