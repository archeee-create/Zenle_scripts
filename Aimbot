local function GetCameraHorizontalDirection(worldPosition)
    if not Camera then
        return "?"
    end

    local direction = worldPosition - Camera.CFrame.Position
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude <= 0.001 then
        return "?"
    end

    direction = direction.Unit

    local forward = Camera.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)

    if forward.Magnitude <= 0.001 then
        return "?"
    end

    forward = forward.Unit

    local right = Camera.CFrame.RightVector
    right = Vector3.new(right.X, 0, right.Z)

    if right.Magnitude <= 0.001 then
        return "?"
    end

    right = right.Unit

    local forwardDot = forward:Dot(direction)
    local rightDot = right:Dot(direction)

    local angle = math.deg(math.atan2(rightDot, forwardDot))

    if angle >= -22.5 and angle < 22.5 then
        return "↑"
    elseif angle >= 22.5 and angle < 67.5 then
        return "↗"
    elseif angle >= 67.5 and angle < 112.5 then
        return "→"
    elseif angle >= 112.5 and angle < 157.5 then
        return "↘"
    elseif angle >= 157.5 or angle < -157.5 then
        return "↓"
    elseif angle >= -157.5 and angle < -112.5 then
        return "↙"
    elseif angle >= -112.5 and angle < -67.5 then
        return "←"
    else
        return "↖"
    end
end

local function IsHorizontallyOnScreen(worldPosition)
    if not Camera then
        return false
    end

    local viewport = Camera.ViewportSize
    local position = Camera:WorldToViewportPoint(worldPosition)

    if position.Z <= 0 then
        return false
    end

    local margin = 20

    return position.X >= margin
        and position.X <= viewport.X - margin
        and position.Y >= margin
        and position.Y <= viewport.Y - margin
end

