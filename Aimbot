local function GetDistance(player)
    local localCharacter = LocalPlayer.Character
    local character = player and player.Character

    local localRoot = GetRoot(localCharacter)
    local root = GetRoot(character)

    if not localRoot or not root then
        return math.huge
    end

    return (localRoot.Position - root.Position).Magnitude
end

local function IsVisualTargetValid(player)
    if not player or player == LocalPlayer then
        return false
    end

    if Settings.VisualsIgnoreTeam and player.Team == LocalPlayer.Team then
        return false
    end

    local character = player.Character
    local humanoid = GetHumanoid(character)
    local root = GetRoot(character)

    if not character or not humanoid or humanoid.Health <= 0 or not root then
        return false
    end

    return GetDistance(player) <= Settings.VisualsDistance
end

