local function UpdateAim()
    if not AimEnabled then
        LockedTarget = nil
        return
    end

    if not LockedTarget or not BasicTargetValid(LockedTarget) then
        LockedTarget = GetClosestTarget()
    end

    if not LockedTarget then
        return
    end

    local character = LockedTarget.Character
    local part = GetTargetPart(character)

    if not part then
        LockedTarget = nil
        return
    end

    if Settings.VisibleCheck and not IsVisible(part, character) then
        LockedTarget = nil
        return
    end

    local cameraPosition = Camera.CFrame.Position
    local desired = CFrame.lookAt(
        cameraPosition,
        part.Position
    )

    local strength = math.clamp(
        Settings.AimStrength / 100,
        0,
        1
    )

    Camera.CFrame = Camera.CFrame:Lerp(
        desired,
        strength
    )
end

local function UpdateFPS()
    FPSFrames += 1

    local now = os.clock()

    if now - FPSTimer >= 1 then
        CurrentFPS = FPSFrames / (now - FPSTimer)
        FPSFrames = 0
        FPSTimer = now
    end
end

local function GetPing()
    local ping = 0

    pcall(function()
        local stats = game:GetService("Stats")
        local network = stats:FindFirstChild("Network")

        if network then
            local serverStats = network:FindFirstChild("ServerStatsItem")

            if serverStats then
                local pingItem = serverStats:FindFirstChild("Data Ping")

                if pingItem then
                    local value = pingItem:GetValueString()
                    value = tostring(value):match("[%d%.]+")

                    if value then
                        ping = tonumber(value) or 0
                    end
                end
            end
        end
    end)

    return ping
end

local function UpdateStatus()
    local ping = GetPing()

    Status.Text =
        "Ping: " ..
        tostring(math.floor(ping + 0.5)) ..
        " ms  FPS: " ..
        tostring(math.floor(CurrentFPS + 0.5))
end

