    label.Font = Enum.Font.GothamMedium
    label.TextSize = textSize
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 112

    local track = Instance.new("Frame")
    track.Parent = holder
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -4, 0.5, 0)
    track.Size = UDim2.fromOffset(46, 22)
    track.BackgroundColor3 = Color3.fromRGB(210, 55, 55)
    track.BorderSizePixel = 0
    track.ZIndex = 113

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local knob = Instance.new("Frame")
    knob.Parent = track
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 114

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local current = value == true
    local changing = false

    local function apply(animated)
        local trackColor
        local knobPosition

        if current then
            trackColor = Color3.fromRGB(55, 195, 90)
            knobPosition = UDim2.new(1, -20, 0.5, 0)
        else
            trackColor = Color3.fromRGB(210, 55, 55)
            knobPosition = UDim2.new(0, 2, 0.5, 0)
        end

        if animated then
            Tween(track, {
                BackgroundColor3 = trackColor
            }, 0.18)

            Tween(knob, {
                Position = knobPosition
            }, 0.18)
        else
            track.BackgroundColor3 = trackColor
            knob.Position = knobPosition
        end
    end

    local function set(newValue, animated, invoke)
        current = newValue == true
        apply(animated ~= false)

        if invoke ~= false and callback then
            callback(current)
        end
    end

    Connect(button.Activated, function()
        if changing then
            return
        end

        changing = true
        current = not current
        apply(true)

        if callback then
            callback(current)
        end

        task.delay(0.16, function()
            changing = false
        end)
    end)

    apply(false)

    return {
        holder = holder,
        button = button,
        label = label,
        track = track,
        knob = knob,
        get = function()
            return current
        end,
        set = set
    }
end

local function CreateSubToggle(text, value, callback)
    local ref = CreateToggle(
        text,
        value,
        callback,
        {
            height = 32,
            indent = 22,
            textSize = 9,
            name = "SubToggle"
        }
    )

    ref.holder.Size = UDim2.new(1, -36, 0, 0)
    ref.holder.Position = UDim2.fromOffset(22, 0)
    ref.holder.Visible = false

    local visible = false

    function ref.setVisible(state, animated)
        visible = state == true

        if visible then
            ref.holder.Visible = true

            if animated then
                Tween(
                    ref.holder,
                    {
                        Size = UDim2.new(1, -36, 0, 32)
                    },
                    0.22
                )
            else
                ref.holder.Size = UDim2.new(1, -36, 0, 32)
            end
        else
            if animated then
                local tween = Tween(
                    ref.holder,
                    {
                        Size = UDim2.new(1, -36, 0, 0)
                    },
                    0.22
                )

                tween.Completed:Once(function()
                    if not visible and ref.holder.Parent then
                        ref.holder.Visible = false
                    end
                end)
            else
                ref.holder.Size = UDim2.new(1, -36, 0, 0)
                ref.holder.Visible = false
            end
        end
    end

    function ref.isVisible()
        return visible
    end

    return ref
end

