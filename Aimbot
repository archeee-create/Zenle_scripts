    local container = VisualObjects[player]

    if not container then
        container = CreateVisualContainer(player)
    end

    local character = player.Character

    if container.Character ~= character then
        container.Character = character
        ClearSkeleton(container)
    end

    if not VisualsEnabled then
        if container.Billboard then
            container.Billboard.Enabled = false
        end

        if container.Box then
            container.Box.Visible = false
        end

        if container.BoxAdornment then
            container.BoxAdornment.Visible = false
        end

        if container.Selection then
            container.Selection.Visible = false
        end

        if container.Highlight then
            container.Highlight.Enabled = false
        end

        if container.Outline then
            container.Outline.Enabled = false
        end

        container.LookLine.Transparency = 1
        container.LookTip.Transparency = 1

        ClearSkeleton(container)
        return
    end

    UpdateHighlight(container, player)
    UpdateBox(container, player)
    Update3DBox(container, player)
    Update3DOutline(container, player)
    UpdateSkeleton(container, player)
    UpdateInformation(container, player)
    UpdateLookDirection(container, player)
end

