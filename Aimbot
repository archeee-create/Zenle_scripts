local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetTargetPart(character)
    if not character then
        return nil
    end

    if Settings.AimPart == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    end

    return character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function BasicTargetValid(player)
    if not player or player == LocalPlayer then
        return false
    end

    if Settings.AimIgnoreTeam and player.Team == LocalPlayer.Team then
        return false
    end

    local character = player.Character
    local humanoid = GetHumanoid(character)
    local root = GetRoot(character)
    local part = GetTargetPart(character)
    local localRoot = GetRoot(LocalPlayer.Character)

    if not character or not humanoid or humanoid.Health <= 0 or not root or not part or not localRoot then
        return false
    end

    return (root.Position - localRoot.Position).Magnitude <= Settings.MaxDistance
end

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsVisible(part, character)
    if not Settings.VisibleCheck then
        return true
    end

    if not Camera or not part or not character then
        return false
    end

    RayParams.FilterDescendantsInstances = {
        LocalPlayer.Character,
        Camera
    }

    local origin = Camera.CFrame.Position
    local direction = part.Position - origin

    local result = workspace:Raycast(origin, direction, RayParams)

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(character)
end

local function GetClosestTarget()
    if not Camera then
        return nil
    end

    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local closest = nil
    local closestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if BasicTargetValid(player) then
            local part = GetTargetPart(player.Character)

            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)

                if onScreen and pos.Z > 0 then
                    local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude

                    if distance <= Settings.AimFOV and distance < closestDistance and IsVisible(part, player.Character) then
                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    return closest
end

local function GetSettingsHeight()
