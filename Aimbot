    knob.Size = UDim2.fromOffset(14, 14)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 113

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local current = math.clamp(
        tonumber(value) or minimum,
        minimum,
        maximum
    )

    local function updateVisual()
        local alpha = 0

        if maximum ~= minimum then
            alpha = (current - minimum) / (maximum - minimum)
        end

        alpha = math.clamp(alpha, 0, 1)

        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        valueLabel.Text = tostring(math.floor(current + 0.5))
    end

    local function setValue(newValue, invoke)
        current = math.clamp(
            tonumber(newValue) or minimum,
            minimum,
            maximum
        )

        updateVisual()

        if invoke ~= false and callback then
            callback(current)
        end
    end

    local function updateFromInput(input)
        local x = input.Position.X
        local left = bar.AbsolutePosition.X
        local width = bar.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local alpha = math.clamp(
            (x - left) / width,
            0,
            1
        )

        setValue(
            minimum + (maximum - minimum) * alpha,
            true
        )
    end

    local function begin(input)
        ActiveSlider = {
            update = function(position)
                updateFromInput({
                    Position = position
                })
            end,
            holder = holder
        }

        updateFromInput(input)
    end

    Connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            begin(input)
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if not ActiveSlider or ActiveSlider.holder ~= holder then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            if ActiveSlider and ActiveSlider.holder == holder then
                ActiveSlider = nil
                SaveSettings()
            end
        end
    end)

    updateVisual()

    return {
        holder = holder,
        set = function(newValue, invoke)
            setValue(newValue, invoke)
        end,
        get = function()
            return current
        end
    }
end

