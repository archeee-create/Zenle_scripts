            RemoveVisualContainer(player)
            RemoveAlert(player)

            if VisualsEnabled then
                CreateVisualContainer(player)
            end
        end)
    end
end

Connect(LocalPlayer.CharacterAdded, function()
    LockedTarget = nil

    task.wait(0.5)

    Camera = workspace.CurrentCamera

    ApplyCameraFOV()
    UpdateFOV()
end)

Connect(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
    Camera = workspace.CurrentCamera

    ApplyCameraFOV()
    UpdateFOV()
end)

Connect(UserInputService.InputChanged, function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if SettingsOpen then
            local current = SettingsScroll.CanvasPosition

            SettingsScroll.CanvasPosition = Vector2.new(
                current.X,
                math.clamp(
                    current.Y - input.Position.Z * 45,
                    0,
                    math.max(
                        0,
                        SettingsScroll.AbsoluteCanvasSize.Y -
                        SettingsScroll.AbsoluteWindowSize.Y
                    )
                )
            )
        end
    end
end)

Connect(RunService.RenderStepped, function()
    UpdateFPS()

    local now = os.clock()

    if now - LastTargetUpdate >= 0.1 then
        LastTargetUpdate = now

        if AimEnabled then
            UpdateAim()
        end
    end

    if now - LastVisualUpdate >= 0.08 then
        LastVisualUpdate = now

        if VisualsEnabled then
            UpdateAllVisuals()
        else
            for player, container in pairs(VisualObjects) do
                if container then
                    if container.Billboard then
                        container.Billboard.Enabled = false
                    end

                    if container.Box then
                        container.Box.Visible = false
                    end

                    if container.BoxAdornment then
                        container.BoxAdornment.Visible = false
                    end

                    if container.Selection then
                        container.Selection.Visible = false
                    end

                    if container.Highlight then
                        container.Highlight.Enabled = false
                    end

                    if container.Outline then
                        container.Outline.Enabled = false
                    end

                    if container.LookLine then
                        container.LookLine.Transparency = 1
                    end

                    if container.LookTip then
                        container.LookTip.Transparency = 1
                    end

                    ClearSkeleton(container)
                end
            end
        end
    end

    if now - LastAlertUpdate >= 0.05 then
        LastAlertUpdate = now

        if VisualsEnabled and Settings.Show360Alert then
            UpdateAllAlerts()
        else
            for player in pairs(AlertObjects) do
                HideAlert(player)
            end
        end
    end

    if now - LastStatusUpdate >= 0.5 then
        LastStatusUpdate = now
        UpdateStatus()
    end
end)

local function Cleanup()
    pcall(function()
        RunService:UnbindFromRenderStep("ZenleScriptCamera")
    end)

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    Connections = {}

    for player in pairs(VisualObjects) do
        RemoveVisualContainer(player)
    end

    for player in pairs(AlertObjects) do
        RemoveAlert(player)
    end

    pcall(function()
        if GUI then
            GUI:Destroy()
        end
    end)

    pcall(function()
        if FOVGui then
            FOVGui:Destroy()
        end
    end)
end

G.ZenleScriptCleanup = Cleanup

ApplyCameraFOV()
SetTab("AIM")
UpdateMainToggle()
UpdateFOV()
UpdateDropdownPosition()
UpdateStatus()
